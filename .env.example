# Copy to .env and fill in your own values. Never commit .env.

# Sage Bridge (Cloudflare Worker in front of D1)
GS_BRIDGE_URL=https://your-bridge.example.workers.dev/query
GS_BRIDGE_KEY=your-bridge-key-here

# Cloudflare D1 database id (used by the dispatch tracker)
GS_D1_DB_ID=your-d1-database-id

# OpenAI (embedding pipeline uses text-embedding-3-small over HTTP)
OPENAI_API_KEY=your-openai-key-here

# Telegram notifications (optional; leave blank to disable)
TG_BOT_TOKEN=
TG_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
